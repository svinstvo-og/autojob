# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALLOWED_TELEGRAM_IDS=123456789

# PostgreSQL (Externally Provisioned)
DATABASE_URL=postgres://user:password@localhost:5432/autojob?sslmode=disable

# Freehire API
FREEHIRE_BASE_URL=https://freehire.me/api/v1
FREEHIRE_API_KEY=

# Default Search Preferences
DEFAULT_CITY=Prague
DEFAULT_CATEGORIES=backend,software_engineering
DEFAULT_LOOKBACK_DAYS=7

# Gemini & CV Tailoring Pipeline
GEMINI_BIN=gemini
GEMINI_MODEL=
BASE_CV_PATH=./assets/base_cv.md
PROMPT_TEMPLATE_PATH=./assets/prompt.tmpl
HTML_TEMPLATE_PATH=./assets/cv_template.html
OUTPUT_DIR=./output
